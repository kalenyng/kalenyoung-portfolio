# Canonical production URL. Required for correct sitemap, OG, and JSON-LD when building locally.
# Vercel Production: SITE_URL=https://kalenyoung.co.uk (trailing slash is fine)
SITE_URL=https://kalenyoung.co.uk

# EmailJS — enables on-site delivery without a server.
# Public key: https://dashboard.emailjs.com/admin/account
# Restrict allowed domains in the EmailJS dashboard for production.
PUBLIC_EMAILJS_PUBLIC_KEY=
