---
import { personSchemaLinks } from '@/lib/site-url';

const site = Astro.site?.href.replace(/\/$/, '') ?? '';

const person = {
  '@type': 'Person',
  '@id': `${site}/#person`,
  name: 'Kalen Young',
  url: site,
  email: 'kalen@kalenyoung.co.uk',
  jobTitle: 'Frontend Developer',
  description:
    'Angular & TypeScript frontend developer. Production work at COHO (UK proptech). Freelance & remote. Dual UK / South African citizen.',
  image: `${site}/images/og/og.png`,
  nationality: [
    { '@type': 'Country', name: 'United Kingdom' },
    { '@type': 'Country', name: 'South Africa' },
  ],
  workLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Durban',
      addressCountry: 'ZA',
    },
  },
  knowsAbout: [
    'Angular',
    'TypeScript',
    'React',
    'Supabase',
    'PostgreSQL',
    'Astro',
    'Tailwind CSS',
    'C#',
    '.NET',
    'Frontend Development',
    'Full-Stack Development',
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'COHO',
    url: 'https://coho.life',
    description: 'UK property technology company',
  },
  sameAs: [personSchemaLinks.github, personSchemaLinks.linkedin],
};

const website = {
  '@type': 'WebSite',
  '@id': `${site}/#website`,
  url: site,
  name: 'Kalen Young',
  description: 'Portfolio of Kalen Young — Angular & TypeScript Frontend Developer',
  author: { '@id': `${site}/#person` },
};

const profilePage = {
  '@type': 'ProfilePage',
  '@id': `${site}/#profilepage`,
  url: site,
  name: 'Kalen Young — Angular & TypeScript Frontend Developer',
  mainEntity: { '@id': `${site}/#person` },
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [person, website, profilePage],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
