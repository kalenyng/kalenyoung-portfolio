---
import type { CollectionEntry } from 'astro:content';
import TiltedCard from '../effects/TiltedCard.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, tagline, role, year, tech } = project.data;
const href = `/projects/${project.id}/`;
const coverAlt = `${title} — case study cover`;
const isFlagship = project.data.flagship === true;

const buttonClass =
  'inline-flex items-center justify-center gap-2 border-2 border-accent bg-accent px-5 py-2.5 text-sm font-medium uppercase tracking-wide text-surface';
---

<TiltedCard rotateAmplitude={6} scaleOnHover={1.015} showTooltip={false} class="h-full">
  <a
    href={href}
    class="group relative block border-2 border-surface-border bg-surface-raised motion-safe:hover:border-accent/60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  >
    <div class="grid gap-0 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
      <div class="tilted-card-cover relative aspect-[16/10] overflow-hidden border-b-2 border-surface-border lg:aspect-auto lg:min-h-full lg:self-stretch lg:border-b-0 lg:border-r-2">
        <img
          src={project.data.cover}
          alt={coverAlt}
          width={1200}
          height={750}
          loading={isFlagship ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={isFlagship ? 'high' : undefined}
          class="h-full w-full object-cover"
        />
      </div>
      <div class="flex flex-col justify-between gap-8 p-5 sm:gap-10 sm:p-8 lg:p-10">
        <div class="space-y-5">
          <div class="flex flex-wrap items-center gap-3 font-mono text-[11px] uppercase tracking-[0.2em] text-paper/45">
            <span class="text-accent">{role}</span>
            <span class="text-paper/25" aria-hidden="true">/</span>
            <span>{year}</span>
          </div>
          <div class="space-y-3">
            <h3 class="font-display text-3xl font-bold uppercase tracking-tight text-paper motion-safe:group-hover:text-accent">
              {title}
            </h3>
            <p class="max-w-prose text-base leading-relaxed text-paper/60">{tagline}</p>
          </div>
          <ul class="flex flex-wrap gap-2" aria-label="Technologies">
            {
              tech.map((t) => (
                <li>
                  <span class="border border-surface-border bg-surface px-2 py-1 font-mono text-[11px] text-paper/70">
                    {t}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="flex flex-wrap gap-3">
          <span class={buttonClass} aria-hidden="true">Read case study</span>
        </div>
      </div>
    </div>
  </a>
</TiltedCard>
