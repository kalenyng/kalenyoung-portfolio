---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<img
  src="/images/icons/black-logo.svg"
  alt="Kalen Young logo"
  width="32"
  height="32"
  class:list={[
    'h-7 w-7 shrink-0 object-contain opacity-40 brightness-0 invert',
    className,
  ]}
  decoding="async"
/>
