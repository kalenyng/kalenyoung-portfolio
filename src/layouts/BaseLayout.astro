---
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/seo/Seo.astro';
import PersonSchema from '../components/seo/PersonSchema.astro';
import Preloader from '../components/Preloader.astro';
import RevealObserver from '../components/motion/RevealObserver.astro';
import ScrollDirector from '../components/motion/ScrollDirector.astro';
import { isPreviewBuild } from '../lib/site-build';
import '../styles/global.css';
import ibmPlex400 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import barlow800 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-800-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, path, image, noindex: noindexProp } = Astro.props;
const noindex = noindexProp ?? isPreviewBuild;
const emailjsPublicKey = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY ?? '';
const isHome = path === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
      var seenIntro = false;
      try {
        seenIntro = sessionStorage.getItem('portfolio-intro-v3') === '1';
      } catch (e) {}
      var skipIntro =
        seenIntro || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (seenIntro) document.documentElement.classList.add('preloader-seen');
      if (skipIntro) document.documentElement.classList.add('hero-static');
      if (!skipIntro) document.documentElement.classList.add('loading');
    </script>
    <style is:inline>
      html.preloader-seen #preloader {
        display: none;
      }
      html.loading [data-nav-brand-scene]:not([data-nav-logo-state='ready']) {
        visibility: hidden;
        opacity: 0;
      }
      html.loading [data-nav-brand-scene][data-nav-logo-state='ready'] {
        visibility: visible;
        opacity: 1;
      }
      html.preloader-seen [data-nav-brand-scene][data-nav-logo-state='ready'] {
        visibility: visible;
        opacity: 1;
      }
      html.loading body {
        overflow: hidden;
      }
      @media (prefers-reduced-motion: reduce) {
        html.loading #preloader {
          display: none !important;
        }
        html.loading body {
          overflow: auto;
        }
      }
      #hero:not([data-hero-ready]) [data-hero-line],
      #hero:not([data-hero-ready]) [data-hero-pop],
      #hero:not([data-hero-ready]) [data-hero-badge],
      #hero:not([data-hero-ready]) [data-hero-stat],
      #hero:not([data-hero-ready]) [data-hero-link] {
        opacity: 0;
        visibility: hidden;
      }
      html.hero-static #hero:not([data-hero-ready]) [data-hero-line],
      html.hero-static #hero:not([data-hero-ready]) [data-hero-pop],
      html.hero-static #hero:not([data-hero-ready]) [data-hero-badge],
      html.hero-static #hero:not([data-hero-ready]) [data-hero-stat],
      html.hero-static #hero:not([data-hero-ready]) [data-hero-link],
      html.preloader-seen #hero:not([data-hero-ready]) [data-hero-line],
      html.preloader-seen #hero:not([data-hero-ready]) [data-hero-pop],
      html.preloader-seen #hero:not([data-hero-ready]) [data-hero-badge],
      html.preloader-seen #hero:not([data-hero-ready]) [data-hero-stat],
      html.preloader-seen #hero:not([data-hero-ready]) [data-hero-link] {
        opacity: 1;
        visibility: visible;
      }
      #preloader {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: #121110;
      }
      html.loading #preloader {
        display: block;
      }
      .nav-brand__logo-slot {
        width: 2.25rem;
        height: 2.25rem;
        flex-shrink: 0;
      }
      .nav-brand {
        flex-shrink: 0;
        width: 11.5rem;
      }
      .nav-brand__name {
        display: block;
        flex: 0 0 8.5rem;
        width: 8.5rem;
        min-width: 8.5rem;
        max-width: 8.5rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: 'Barlow Condensed', ui-sans-serif, system-ui, sans-serif;
        font-size: 1.125rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        text-transform: uppercase;
      }
      .card-nav-cta-button {
        min-width: 5.5rem;
        text-align: center;
      }
      @media (max-width: 768px) {
        .nav-brand__logo-slot {
          width: 2rem;
          height: 2rem;
        }
        .nav-brand {
          width: 10.25rem;
        }
        .nav-brand__name {
          flex: 1 1 6.75rem;
          width: 6.75rem;
          min-width: 6.75rem;
          max-width: 6.75rem;
          font-size: 0.875rem;
        }
      }
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href="/fonts/barlow-condensed-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlow800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ibmPlex400} as="font" type="font/woff2" crossorigin />
    {
      emailjsPublicKey && (
        <link rel="preconnect" href="https://api.emailjs.com" crossorigin />
      )
    }
    {
      isHome && (
        <link
          rel="preload"
          as="image"
          href="/images/projects/propza-cover.webp"
          type="image/webp"
        />
      )
    }
    <style is:inline>
      @font-face {
        font-family: 'Barlow Condensed';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/barlow-condensed-700.woff2') format('woff2');
      }
    </style>
    <link rel="icon" type="image/svg+xml" href="/images/icons/logo-new.svg" />
    <script is:inline>
      if (seenIntro) {
        var glb = document.createElement('link');
        glb.rel = 'preload';
        glb.as = 'fetch';
        glb.href = '/logo-mark.glb';
        glb.crossOrigin = 'anonymous';
        document.head.appendChild(glb);
      }
    </script>
    <Seo title={title} description={description} path={path} image={image} noindex={noindex} />
    {isHome && <PersonSchema />}
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="relative">
    <Preloader />
    <noscript>
      <style>
        [data-motion-reveal],
        [data-hero-line],
        [data-hero-pop],
        [data-hero-badge] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <slot />
    <RevealObserver />
    <ScrollDirector />
    <script>
      import { setupNavLogoController } from '@/lib/nav-logo-controller';
      import { setupHeroLineWaves } from '@/lib/hero-line-waves-boot';

      setupNavLogoController();
      setupHeroLineWaves();
    </script>
  </body>
</html>
