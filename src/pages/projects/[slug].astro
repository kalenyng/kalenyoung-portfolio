---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, tagline, role, year, tech } = project.data;
const pageTitle = `${title} — Case study`;
const description = tagline;
const coverAlt = `${title} — case study cover`;
const ogImage = new URL(project.data.cover, Astro.site).href;
const panCoverRight = project.id === 'propza';
---

<BaseLayout title={pageTitle} {description} path={`/projects/${project.id}/`} image={ogImage}>
  <SiteHeader />
  <main id="main" class="site-header-offset border-b-2 border-surface-border">
    <article class="mx-auto max-w-[1400px] px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <header class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div class="space-y-6">
          <p class="brutal-label">Case study</p>
          <h1 class="font-display text-balance text-[clamp(2.5rem,6vw,4rem)] font-bold uppercase leading-[0.92] tracking-tight text-paper">
            {title}
          </h1>
          <p class="max-w-xl text-lg leading-relaxed text-paper/65">{tagline}</p>
          <dl class="flex flex-wrap gap-8 font-mono text-[11px] uppercase tracking-[0.18em] text-paper/45">
            <div>
              <dt class="text-paper/30">Role</dt>
              <dd class="mt-1 text-paper/70">{role}</dd>
            </div>
            <div>
              <dt class="text-paper/30">Year</dt>
              <dd class="mt-1 text-paper/70">{year}</dd>
            </div>
          </dl>
          <ul class="flex flex-wrap gap-2" aria-label="Technologies">
            {
              tech.map((t) => (
                <li>
                  <span class="border border-surface-border bg-surface-raised px-2 py-1 font-mono text-[11px] text-paper/70">
                    {t}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div
          class:list={[
            'overflow-hidden border-2 border-surface-border bg-surface-raised',
            panCoverRight && 'project-cover--pan-right aspect-[16/10]',
          ]}
        >
          {
            panCoverRight ? (
              <div
                class="project-cover-bg h-full w-full bg-cover bg-no-repeat"
                style={`background-image: url('${project.data.cover}');`}
                role="img"
                aria-label={coverAlt}
              />
            ) : (
              <img
                src={project.data.cover}
                alt={coverAlt}
                width={1200}
                height={750}
                class="aspect-[16/10] w-full object-cover"
                loading="eager"
                decoding="async"
              />
            )
          }
        </div>
      </header>

      <div class="prose-case mx-auto mt-16 max-w-2xl lg:mt-20">
        <Content />
      </div>

      <nav class="mt-20 border-t-2 border-surface-border pt-10 font-mono text-[11px] uppercase tracking-[0.2em]" aria-label="Case study">
        <a href="/#work" class="text-paper/45 motion-safe:hover:text-accent">← Back to work</a>
      </nav>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>
