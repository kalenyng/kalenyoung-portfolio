---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
---

<BaseLayout
  title="Privacy Policy — Kalen Young"
  description="Privacy policy for kalenyoung.co.uk. Covers contact form data handling via EmailJS."
  path="/privacy/"
>
  <SiteHeader />
  <main id="main" tabindex="-1" class="site-header-offset border-b-2 border-surface-border">
    <div class="mx-auto max-w-[1400px] px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <div class="mx-auto max-w-4xl">
    <a href="/" class="mb-10 inline-block font-mono text-[11px] uppercase tracking-[0.2em] text-paper/45 motion-safe:hover:text-accent">← Back</a>
    <p class="brutal-label mb-6">Privacy Policy</p>
    <h1 class="font-display mb-10 text-3xl font-bold uppercase leading-tight tracking-tight text-paper sm:text-4xl">
      How your data is handled
    </h1>

    <div class="space-y-8 text-[16px] leading-relaxed text-paper/75">
      <section>
        <h2 class="mb-3 font-display text-lg font-bold uppercase tracking-tight text-paper">Who I am</h2>
        <p>This site is operated by Kalen Young, a freelance frontend developer based in Durban, South Africa. Contact: <a href="mailto:kalen@kalenyoung.co.uk" class="text-accent hover:underline">kalen@kalenyoung.co.uk</a></p>
      </section>

      <section>
        <h2 class="mb-3 font-display text-lg font-bold uppercase tracking-tight text-paper">What data the contact form collects</h2>
        <p>When you submit the contact form, the following information is sent:</p>
        <ul class="mt-3 list-disc space-y-1 pl-5">
          <li>Your name</li>
          <li>Your email address</li>
          <li>The message you write</li>
        </ul>
        <p class="mt-3">This information is used solely to respond to your enquiry.</p>
      </section>

      <section>
        <h2 class="mb-3 font-display text-lg font-bold uppercase tracking-tight text-paper">How it's processed</h2>
        <p>The contact form uses <a href="https://www.emailjs.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">EmailJS</a> to deliver messages directly to my inbox. EmailJS acts as a data processor. Your submission is transmitted over HTTPS and delivered as an email. EmailJS's own privacy policy governs how they handle data in transit — no message content is stored on their servers beyond delivery.</p>
        <p class="mt-3">I do not use your details for marketing, pass them to third parties, or store them in any database.</p>
      </section>

      <section>
        <h2 class="mb-3 font-display text-lg font-bold uppercase tracking-tight text-paper">Retention</h2>
        <p>Your message is retained in my email inbox for as long as needed to respond and complete any engagement. You can request deletion at any time by emailing <a href="mailto:kalen@kalenyoung.co.uk" class="text-accent hover:underline">kalen@kalenyoung.co.uk</a>.</p>
      </section>

      <section>
        <h2 class="mb-3 font-display text-lg font-bold uppercase tracking-tight text-paper">Cookies and tracking</h2>
        <p>This site sets no cookies and uses no analytics or tracking scripts.</p>
      </section>

      <section>
        <h2 class="mb-3 font-display text-lg font-bold uppercase tracking-tight text-paper">Your rights (UK GDPR)</h2>
        <p>If you are based in the UK or EU, you have the right to access, correct, or request deletion of any personal data I hold about you. To exercise any of these rights, contact <a href="mailto:kalen@kalenyoung.co.uk" class="text-accent hover:underline">kalen@kalenyoung.co.uk</a>.</p>
      </section>

      <p class="border-t-2 border-surface-border pt-6 font-mono text-[11px] uppercase tracking-[0.15em] text-paper/30">
        Last updated: May 2026
      </p>
    </div>
    </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
