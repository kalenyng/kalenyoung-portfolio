---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import ProductionExperience from '../components/sections/ProductionExperience.astro';
import FeaturedProjects from '../components/sections/FeaturedProjects.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const flagship = projects.find((p) => p.data.flagship);
const secondaryOrder = ['personal-budget-tracker', 'simon-clark-fitness'] as const;
const secondary = projects
  .filter((p) => !p.data.flagship)
  .sort((a, b) => {
    const ia = secondaryOrder.indexOf(a.id as (typeof secondaryOrder)[number]);
    const ib = secondaryOrder.indexOf(b.id as (typeof secondaryOrder)[number]);
    if (ia === -1 && ib === -1) return b.data.year - a.data.year;
    if (ia === -1) return 1;
    if (ib === -1) return -1;
    return ia - ib;
  });

if (!flagship) {
  throw new Error('Content collection must include one flagship project.');
}

const title = 'Kalen Young — Angular & TypeScript Frontend Developer';
const description =
  'Angular & TypeScript frontend developer. Production work at COHO (UK proptech). Freelance & remote. Dual UK / South African citizen.';
---

<BaseLayout {title} {description} path="/">
  <SiteHeader />
  <main id="main" tabindex="-1">
    <Hero />
    <ProductionExperience />
    <FeaturedProjects flagship={flagship} secondary={secondary} />
    <About />
    <Contact />
  </main>
  <SiteFooter />
</BaseLayout>
